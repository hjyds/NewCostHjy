@using System.Collections.Generic
@{
    ViewData["Title"] = "检验申请单测试页面";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var parDic = ViewBag.BaseData as IDictionary<string, string> ?? new Dictionary<string, string>();
}

<style>
    .application-page {
        padding: 24px;
    }

    .application-title {
        margin-bottom: 16px;
        font-size: 24px;
        font-weight: 600;
        color: #1f2937;
    }

    .application-subtitle {
        margin-bottom: 16px;
        color: #4b5563;
    }

    .application-toolbar {
        margin-bottom: 16px;
    }

    .application-save-result {
        margin-top: 12px;
        color: #2563eb;
    }

    .application-table {
        width: 100%;
        border-collapse: collapse;
        background: #ffffff;
    }

    .application-table th,
    .application-table td {
        padding: 12px 14px;
        border: 1px solid #d9e2f1;
        text-align: left;
        vertical-align: top;
        word-break: break-all;
    }

    .application-table th {
        background: #eef4fb;
        color: #111827;
    }

    .application-empty {
        color: #6b7280;
    }
</style>

<div class="application-page">
    <div class="application-title">检验申请单测试页面</div>
    <div class="application-subtitle">当前地址传入参数</div>
    <div class="application-toolbar">
        <button type="button" class="btn btn-primary" id="btnSaveApplication">保存申请</button>
        <div class="application-save-result" id="saveApplicationResult"></div>
        <div class="application-save-result" id="post_data_info"></div>
    </div>

    <table class="application-table">
        <thead>
            <tr>
                <th style="width: 260px;">参数名</th>
                <th>参数值</th>
            </tr>
        </thead>
        <tbody>
            @if (parDic.Count == 0)
            {
                <tr>
                    <td colspan="2" class="application-empty">当前地址没有传入参数。</td>
                </tr>
            }
            else
            {
                foreach (var item in parDic)
                {
                    <tr>
                        <td>@item.Key</td>
                        <td>@item.Value</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="~/js/application_set/application.js" asp-append-version="true"></script>
}
