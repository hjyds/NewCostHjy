@using System.Collections.Generic
@{
    ViewData["Title"] = "护理输血测试页面";
    Layout = "~/Views/Shared/_HjyLyt.cshtml";
    var parDic = ViewBag.PathParams as IDictionary<string, string> ?? new Dictionary<string, string>();
    var rawPath = ViewBag.RawPath as string ?? "";
}

<style>
    .blood-test-page {
        padding: 24px;
    }

    .blood-test-title {
        margin-bottom: 12px;
        font-size: 22px;
        font-weight: 600;
        color: #1f2937;
    }

    .blood-test-sub {
        margin-bottom: 18px;
        color: #4b5563;
        word-break: break-all;
    }

    .blood-test-table {
        width: 100%;
        border-collapse: collapse;
        background: #fff;
    }

    .blood-test-table th,
    .blood-test-table td {
        padding: 12px 14px;
        border: 1px solid #d9e2f1;
        text-align: left;
        vertical-align: top;
        word-break: break-all;
    }

    .blood-test-table th {
        background: #eef4fb;
        color: #1f2937;
    }

    .blood-test-empty {
        color: #6b7280;
    }
</style>

<div class="blood-test-page">
    <div class="blood-test-title">护理输血测试页面</div>
    <div class="blood-test-sub">
        当前访问路径：<span id="raw_path">@rawPath</span>
    </div>

    <table class="blood-test-table">
        <thead>
            <tr>
                <th style="width: 240px;">参数名</th>
                <th>参数值</th>
            </tr>
        </thead>
        <tbody>
            @if (parDic.Count == 0)
            {
                <tr>
                    <td colspan="2" class="blood-test-empty">当前请求没有接收到参数。</td>
                </tr>
            }
            else
            {
                foreach (var item in parDic)
                {
                    <tr>
                        <td>@item.Key</td>
                        <td>@item.Value</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
