@{
    ViewData["Title"] = "临床人员问题查询";
    Layout = "_Layout";
}

<div class="container-fluid">
    <!-- 页面头部 -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="card border-primary">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-user-md"></i> @ViewBag.Title
                    </h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label><strong>产品名称：</strong></label>
                                <input type="text" class="form-control" value="@ViewBag.ProductName" readonly />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label><strong>当前时间：</strong></label>
                                <input type="text" class="form-control" value="@ViewBag.CurrentTime" readonly />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label><strong>查询状态：</strong></label>
                                <select class="form-control" id="statusFilter">
                                    <option value="">全部</option>
                                    <option value="待信息科处理" selected>待信息科处理</option>
                                    <option value="已处理">已处理</option>
                                    <option value="处理中">处理中</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 查询条件 -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-search"></i> 查询条件
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>问题编号</label>
                                <input type="text" class="form-control" id="queryId" placeholder="请输入问题编号" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>开始时间</label>
                                <input type="datetime-local" class="form-control" id="startTime" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>结束时间</label>
                                <input type="datetime-local" class="form-control" id="endTime" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>&nbsp;</label>
                                <div>
                                    <button class="btn btn-primary" onclick="searchData()">
                                        <i class="fas fa-search"></i> 查询
                                    </button>
                                    <button class="btn btn-secondary" onclick="resetQuery()">
                                        <i class="fas fa-undo"></i> 重置
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 数据列表 -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-list"></i> 问题列表
                    </h5>
                    <div>
                        <button class="btn btn-sm btn-success" onclick="exportToExcel()">
                            <i class="fas fa-file-excel"></i> 导出Excel
                        </button>
                        <button class="btn btn-sm btn-info" onclick="printData()">
                            <i class="fas fa-print"></i> 打印
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover" id="clinicalTable">
                            <thead class="thead-light">
                                <tr>
                                    <th style="width: 5%;">
                                        <input type="checkbox" id="selectAll" />
                                    </th>
                                    <th style="width: 12%;">问题编号</th>
                                    <th style="width: 35%;">问题内容</th>
                                    <th style="width: 12%;">状态</th>
                                    <th style="width: 18%;">创建时间</th>
                                    <th style="width: 10%;">创建人</th>
                                    <th style="width: 8%;">操作</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ViewBag.IssueList != null)
                                {
                                    foreach (var item in ViewBag.IssueList)
                                    {
                                        <tr data-id="@item.Id">
                                            <td>
                                                <input type="checkbox" class="row-checkbox" value="@item.Id" />
                                            </td>
                                            <td>@item.Id</td>
                                            <td>
                                                @if (string.IsNullOrEmpty(item.Content))
                                                {
                                                    <span class="text-muted">（无内容描述）</span>
                                                }
                                                else
                                                {
                                                    <span title="@item.Content">@(item.Content.Length > 50 ? item.Content.Substring(0, 50) + "..." : item.Content)</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge badge-warning badge-status">@item.Status</span>
                                            </td>
                                            <td>@item.CreateTime</td>
                                            <td>@item.Creator</td>
                                            <td>
                                                <button class="btn btn-sm btn-primary" onclick="viewDetail('@item.Id')">
                                                    <i class="fas fa-eye"></i> 查看
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    
                    <!-- 分页 -->
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center" id="pagination">
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1">上一页</a>
                            </li>
                            <li class="page-item active"><a class="page-link" href="#">1</a></li>
                            <li class="page-item"><a class="page-link" href="#">2</a></li>
                            <li class="page-item"><a class="page-link" href="#">3</a></li>
                            <li class="page-item">
                                <a class="page-link" href="#">下一页</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>

    <!-- 统计信息 -->
    <div class="row mt-3">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-chart-bar"></i> 统计信息
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-3">
                            <div class="alert alert-primary">
                                <h4>@ViewBag.IssueList?.Count</h4>
                                <p class="mb-0">总问题数</p>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="alert alert-warning">
                                <h4>@ViewBag.IssueList?.Count</h4>
                                <p class="mb-0">待处理</p>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="alert alert-success">
                                <h4>0</h4>
                                <p class="mb-0">已处理</p>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="alert alert-info">
                                <h4>0</h4>
                                <p class="mb-0">处理中</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 详情弹窗 -->
<div class="modal fade" id="detailModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">问题详情</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="detailContent">
                <!-- 详情内容 -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">关闭</button>
                <button type="button" class="btn btn-primary" onclick="processIssue()">处理</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // 初始化表格
            initTable();
            
            // 全选/取消全选
            $('#selectAll').change(function() {
                $('.row-checkbox').prop('checked', $(this).prop('checked'));
            });
            
            // 设置默认时间
            var now = new Date();
            var lastMonth = new Date(now.getFullYear(), now.getMonth() - 1, now.getDate());
            $('#endTime').val(formatDateTime(now));
            $('#startTime').val(formatDateTime(lastMonth));
        });

        function initTable() {
            $('#clinicalTable').bootstrapTable({
                pagination: true,
                pageSize: 10,
                pageList: [10, 25, 50],
                search: true,
                showColumns: true,
                showRefresh: true,
                sortable: true,
                striped: true
            });
        }

        function formatDateTime(date) {
            var year = date.getFullYear();
            var month = String(date.getMonth() + 1).padStart(2, '0');
            var day = String(date.getDate()).padStart(2, '0');
            var hours = String(date.getHours()).padStart(2, '0');
            var minutes = String(date.getMinutes()).padStart(2, '0');
            return year + '-' + month + '-' + day + 'T' + hours + ':' + minutes;
        }

        function searchData() {
            var queryId = $('#queryId').val();
            var startTime = $('#startTime').val();
            var endTime = $('#endTime').val();
            var status = $('#statusFilter').val();
            
            layer.msg('正在查询...', { icon: 16, time: 1000 });
            
            // 模拟查询
            setTimeout(function() {
                layer.msg('查询完成', { icon: 1 });
            }, 1000);
        }

        function resetQuery() {
            $('#queryId').val('');
            $('#statusFilter').val('待信息科处理');
            var now = new Date();
            var lastMonth = new Date(now.getFullYear(), now.getMonth() - 1, now.getDate());
            $('#endTime').val(formatDateTime(now));
            $('#startTime').val(formatDateTime(lastMonth));
        }

        function viewDetail(id) {
            // 查找对应数据
            var content = '问题编号：' + id + '<br><br>';
            content += '问题内容：待信息科处理的问题详情<br>';
            content += '创建时间：2026-03-28<br>';
            content += '创建人：管理员<br>';
            content += '状态：待信息科处理<br>';
            
            $('#detailContent').html(content);
            $('#detailModal').modal('show');
        }

        function processIssue() {
            layer.confirm('确定要处理该问题吗？', {
                btn: ['确定', '取消']
            }, function() {
                layer.msg('处理成功', { icon: 1 });
                $('#detailModal').modal('hide');
            });
        }

        function exportToExcel() {
            layer.msg('正在导出Excel...', { icon: 16, time: 2000 });
            $('#clinicalTable').tableExport({
                type: 'excel',
                fileName: '临床人员问题查询_' + new Date().getTime(),
                escape: false
            });
        }

        function printData() {
            window.print();
        }
    </script>
}

<style>
    .card {
        margin-bottom: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    .card-header {
        font-weight: bold;
    }
    .table th {
        text-align: center;
        vertical-align: middle;
        font-weight: 600;
    }
    .table td {
        vertical-align: middle;
    }
    .badge-status {
        font-size: 0.85em;
        padding: 5px 10px;
    }
    .alert h4 {
        margin-bottom: 5px;
        font-weight: bold;
    }
    .pagination {
        margin-top: 20px;
    }
    .form-group label {
        font-weight: 500;
    }
</style>
