@model NewCostHjy.Models.ToDoItem

@{ 
    ViewData["Title"] = "删除待办事项";
    Layout = "_Layout"; 
}

<div class="container mt-4">
    <h1>@ViewData["Title"]</h1>
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">确认删除</h4>
            <p class="card-text">您确定要删除以下待办事项吗？</p>
            <dl class="row">
                <dt class="col-sm-2">ID:</dt>
                <dd class="col-sm-10">@Model.Id</dd>
                <dt class="col-sm-2">标题:</dt>
                <dd class="col-sm-10">@Model.Title</dd>
                <dt class="col-sm-2">描述:</dt>
                <dd class="col-sm-10">@Model.Description</dd>
                <dt class="col-sm-2">状态:</dt>
                <dd class="col-sm-10">
                    @if (Model.IsCompleted)
                    {
                        <span class="badge badge-success">已完成</span>
                    }
                    else
                    {
                        <span class="badge badge-warning">未完成</span>
                    }
                </dd>
            </dl>
            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="form-group">
                    <input type="submit" value="删除" class="btn btn-danger" />
                    <a asp-action="Index" class="btn btn-secondary">取消</a>
                </div>
            </form>
        </div>
    </div>
</div>