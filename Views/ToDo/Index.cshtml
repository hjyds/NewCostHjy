@model IEnumerable<NewCostHjy.Models.ToDoItem>

@{ 
    ViewData["Title"] = "待办事项列表";
    Layout = "_Layout"; 
}

<div class="container mt-4">
    <h1>@ViewData["Title"]</h1>
    <div class="mb-3">
        <a asp-action="Create" class="btn btn-primary">添加待办事项</a>
    </div>
    <div class="card">
        <div class="card-body">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>标题</th>
                        <th>描述</th>
                        <th>状态</th>
                        <th>创建时间</th>
                        <th>完成时间</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Title</td>
                            <td>@item.Description</td>
                            <td>
                                @if (item.IsCompleted)
                                {
                                    <span class="badge badge-success">已完成</span>
                                }
                                else
                                {
                                    <span class="badge badge-warning">未完成</span>
                                }
                            </td>
                            <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>@(item.CompletedAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">编辑</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">删除</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>