@using System.Collections.Generic
@{
    ViewData["Title"] = "MICPK管控详情页面";
    Layout = "~/Views/Shared/_HjyLyt.cshtml";
    var parDic = ViewBag.BaseData as IDictionary<string, string> ?? new Dictionary<string, string>();
}

<style>
    .micpk-page {
        padding: 24px;
    }

    .micpk-title {
        margin-bottom: 16px;
        font-size: 22px;
        font-weight: 600;
        color: #1f2937;
    }

    .micpk-table {
        width: 100%;
        border-collapse: collapse;
        background: #fff;
    }

    .micpk-table th,
    .micpk-table td {
        padding: 12px 14px;
        border: 1px solid #d9e2f1;
        text-align: left;
        vertical-align: top;
        word-break: break-all;
    }

    .micpk-table th {
        background: #eef4fb;
        color: #1f2937;
    }

    .micpk-empty {
        color: #6b7280;
    }
</style>

<div class="micpk-page">
    <div class="micpk-title">(医保管控对接（测试网页）)入参信息</div>

    <table class="micpk-table">
        <thead>
            <tr>
                <th style="width: 240px;">参数名</th>
                <th>参数值</th>
            </tr>
        </thead>
        <tbody>
            @if (parDic.Count == 0)
            {
                <tr>
                    <td colspan="2" class="micpk-empty">当前请求没有接收到参数。</td>
                </tr>
            }
            else
            {
                foreach (var item in parDic)
                {
                    <tr>
                        <td>@item.Key</td>
                        <td>@item.Value</td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <button class="btn" id="btn_submit" style="float: left;background-color: #ced1e2;">提交</button>
    <button class="btn" id="btn_close" style="float: left;background-color: #ced1e2;">关闭</button>
</div>
<script src="~/module/patientvte/micpk.js" asp-append-version="true"></script>
